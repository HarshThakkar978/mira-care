# Mira on WhatsApp — set these in Vercel → Project → Settings → Environment Variables.
# Never put real values in this file or commit them to GitHub.

# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# From Meta → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret phrase you make up; type the same phrase into Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Optional: Meta → App settings → Basic → App secret (checks webhooks really come from Meta)
WHATSAPP_APP_SECRET=

# Added automatically when you connect Upstash Redis in Vercel → Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional tuning
# MIRA_MODEL=claude-opus-5-5      (claude-haiku-5-5 is much cheaper)
# MIRA_EFFORT=low
# MIRA_TIMEZONE=America/New_York
